b-6 drop-shadow-sm text-center\">🛠️ Tecnologías (resumen)</h3>\r\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\r\n          <div class=\"space-y-3\">\r\n            <div>\r\n              <div class=\"flex justify-between text-[11px] sm:text-xs text-gray-300 mb-1\"><span>HTML5</span><span>85%</span></div>\r\n              <div class=\"h-2 bg-gray-800 rounded-full overflow-hidden\"><div class=\"progress-fill h-full bg-gradient-to-r from-red-500 to-red-600 w-0 transition-all duration-700\" data-progress=\"85\"></div></div>\r\n            </div>\r\n            <div>\r\n              <div class=\"flex justify-between text-[11px] sm:text-xs text-gray-300 mb-1\"><span>CSS3</span><span>85%</span></div>\r\n              <div class=\"h-2 bg-gray-800 rounded-full overflow-hidden\"><div class=\"progress-fill h-full bg-gradient-to-r from-red-500 to-red-600 w-0 transition-all duration-700\" data-progress=\"85\"></div></div>\r\n            </div>\r\n            <div>\r\n              <div class=\"flex justify-between text-[11px] sm:text-xs text-gray-300 mb-1\"><span>JavaScript</span><span>80%</span></div>\r\n              <div class=\"h-2 bg-gray-800 rounded-full overflow-hidden\"><div class=\"progress-fill h-full bg-gradient-to-r from-red-500 to-red-600 w-0 transition-all duration-700\" data-progress=\"80\"></div></div>\r\n            </div>\r\n            <div>\r\n              <div class=\"flex justify-between text-[11px] sm:text-xs text-gray-300 mb-1\"><span>Java</span><span>55%</span></div>\r\n              <div class=\"h-2 bg-gray-800 rounded-full overflow-hidden\"><div class=\"progress-fill h-full bg-gradient-to-r from-red-500 to-red-600 w-0 transition-all duration-700\" data-progress=\"55\"></div></div>\r\n            </div>\r\n            <div>\r\n              <div class=\"flex justify-between text-[11px] sm:text-xs text-gray-300 mb-1\"><span>TailwindCSS</span><span>70%</span></div>\r\n              <div class=\"h-2 bg-gray-800 rounded-full overflow-hidden\"><div class=\"progress-fill h-full bg-gradient-to-r from-blue-500 to-blue-600 w-0 transition-all duration-700\" data-progress=\"70\"></div></div>\r\n            </div>\r\n          </div>\r\n          <div class=\"space-y-3\">\r\n            <div>\r\n              <div class=\"flex justify-between text-[11px] sm:text-xs text-gray-300 mb-1\"><span>React</span><span>60%</span></div>\r\n              <div class=\"h-2 bg-gray-800 rounded-full overflow-hidden\"><div class=\"progress-fill h-full bg-gradient-to-r from-blue-500 to-blue-600 w-0 transition-all duration-700\" data-progress=\"60\"></div></div>\r\n            </div>\r\n            <div>\r\n              <div class=\"flex justify-between text-[11px] sm:text-xs text-gray-300 mb-1\"><span>Python</span><span>75%</span></div>\r\n              <div class=\"h-2 bg-gray-800 rounded-full overflow-hidden\"><div class=\"progress-fill h-full bg-gradient-to-r from-red-500 to-red-600 w-0 transition-all duration-700\" data-progress=\"75\"></div></div>\r\n            </div>\r\n            <div>\r\n              <div class=\"flex justify-between text-[11px] sm:text-xs text-gray-300 mb-1\"><span>Flask</span><span>70%</span></div>\r\n              <div class=\"h-2 bg-gray-800 rounded-full overflow-hidden\"><div class=\"progress-fill h-full bg-gradient-to-r from-blue-500 to-blue-600 w-0 transition-all duration-700\" data-progress=\"70\"></div></div>\r\n            </div>\r\n            <div>\r\n              <div class=\"flex justify-between text-[11px] sm:text-xs text-gray-300 mb-1\"><span>SQLAlchemy</span><span>65%</span></div>\r\n              <div class=\"h-2 bg-gray-800 rounded-full overflow-hidden\"><div class=\"progress-fill h-full bg-gradient-to-r from-blue-500 to-blue-600 w-0 transition-all duration-700\" data-progress=\"65\"></div></div>\r\n            </div>\r\n            <div>\r\n              <div class=\"flex justify-between text-[11px] sm:text-xs text-gray-300 mb-1\"><span>MySQL</span><span>65%</span></div>\r\n