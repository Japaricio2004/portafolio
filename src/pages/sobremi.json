ext-left\" data-src=\"images/CCNA.jpeg\" data-title=\"Cisco: Introducción a Redes\" data-issuer=\"Cisco\" data-date=\"Jul 2025\" aria-haspopup=\"dialog\">\r\n                                <div class=\"h-44 bg-gray-800 rounded-md overflow-hidden flex items-center justify-center\">\r\n                                    <img src=\"images/CCNA.jpeg\" alt=\"Certificado CCNA\" class=\"w-full h-full object-cover transition-transform duration-300 group-hover:scale-105\" />\r\n                                </div>\r\n                                <div class=\"mt-3 text-left\">\r\n                                    <h4 class=\"text-sm font-semibold text-gray-100\">Introducción a Redes</h4>\r\n                                    <p class=\"text-xs text-gray-400\">Redes · Cisco · Jul 2025</p>\r\n                                </div>\r\n                            </button>\r\n                        </div>\r\n\r\n                        <!-- Card: Cisco Introducción a la Ciencia de Datos -->\r\n                        <div class=\"bg-gray-900/90 rounded-xl p-4 border border-gray-800 shadow-3d transition\">\r\n                            <button class=\"cert-open w-full text-left\" data-src=\"images/CCNA2.png\" data-title=\"Cisco: Introducción a la Ciencia de Datos\" data-issuer=\"Cisco\" data-date=\"Nov 2025\" aria-haspopup=\"dialog\">\r\n                                <div class=\"h-44 bg-gray-800 rounded-md overflow-hidden flex items-center justify-center\">\r\n                                    <img src=\"images/CCNA2.png\" alt=\"Certificado CCNA2\" class=\"w-full h-full object-cover transition-transform duration-300 group-hover:scale-105\" />\r\n                                </div>\r\n                                <div class=\"mt-3 text-left\">\r\n                                    <h4 class=\"text-sm font-semibold text-gray-100\">Introducción a la Ciencia de Datos</h4>\r\n                                    <p class=\"text-xs text-gray-400\">Datos · Cisco · Nov 2025</p>\r\n                                </div>\r\n                            </button>\r\n                        </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n\r\n        <!-- Modal reutilizable para vista previa -->\r\n        <div id=\"cert-modal\" class=\"fixed inset-0 z-50 flex items-center justify-center bg-black/70 hidden\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"cert-modal-title\">\r\n            <div class=\"bg-gray-900 rounded-lg w-[95%] md:w-3/4 lg:w-2/3 max-w-6xl max-h-[92vh] overflow-hidden border border-gray-800 shadow-3d\">\r\n                <div class=\"flex items-center justify-between p-3 border-b border-gray-800\">\r\n                    <div>\r\n                        <h4 id=\"cert-modal-title\" class=\"text-sm sm:text-base text-gray-100 font-semibold\">Vista previa</h4>\r\n                        <p id=\"cert-modal-meta\" class=\"text-xs text-gray-400\">&nbsp;</p>\r\n                    </div>\r\n                    <button id=\"cert-close\" class=\"text-gray-300 hover:text-white p-1\" aria-label=\"Cerrar vista previa\">✕</button>\r\n                </div>\r\n                <div class=\"p-0 bg-black flex items-center justify-center\">\r\n                    <img id=\"cert-modal-img\" src=\"\" alt=\"\" class=\"w-full h-[85vh] object-contain bg-black\" />\r\n                </div>\r\n                <div class=\"p-3 flex justify-end gap-2 border-t border-gray-800\">\r\n                    <a id=\"cert-modal-open\" href=\"#\" target=\"_blank\" rel=\"noopener\" class=\"px-4 py-2 bg-red-500 text-white rounded-md\">Abrir en nueva pestaña</a>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n    <section class=\"py-8 sm:py-12 lg:py-16 text-center px-4 sm:px-6\">\r\n        <div class=\"bg-gray-900/60 backdrop-blur-sm rounded-xl sm:rounded-2xl p-6 sm:p-8 max-w-4xl mx-auto border border-gray-800 shadow-3d\">\r\n            <blockquote class=\"italic text-base sm:text-lg lg:text-xl text-gray-300 max-w-2xl mx-auto drop-shadow-sm\">\r\n                \"La pasión por aprender es la mejor herramienta para crecer como profesional.\"\r\n            </blockquote>\r\n                </div>\r\n        </section>\r\n</main>\r\n\r\n\r\n\r\n\r\n"