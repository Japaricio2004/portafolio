"\r\n\r\n\r\n\r\n<main class=\"px-4 sm:px-6\">\r\n    \r\n    <section class=\"max-w-5xl mx-auto py-8 sm:py-12 lg:py-16\">\r\n        <div class=\"bg-gray-900/95 rounded-2xl sm:rounded-3xl p-6 sm:p-8 lg:p-10 text-center transition duration-300 shadow-3d border border-gray-800\">\r\n            <div class=\"relative inline-block mx-auto mb-4 sm:mb-6 group\">\r\n                <div class=\"absolute -inset-2 sm:inset-0 rounded-full bg-gradient-to-r from-red-500 via-red-400 to-red-600 blur-md opacity-50\"></div>\r\n                <div class=\"absolute -inset-1 sm:inset-0 rounded-full bg-gradient-to-r from-red-500/40 via-red-400/30 to-red-600/30\"></div>\r\n                <img src=\"/images/ImagenPortafolio.jpeg\" alt=\"Foto de Jorge\" class=\"relative w-32 h-32 sm:w-40 sm:h-40 md:w-44 md:h-44 lg:w-48 lg:h-48 rounded-full object-cover ring-4 ring-red-500 shadow-[0_18px_45px_rgba(239,68,68,0.35)] transition-all duration-500 hover:scale-110 hover:-rotate-1\" />\r\n            </div>\r\n            <h2 class=\"text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold text-red-500 mb-3 sm:mb-4 drop-shadow-lg\">¡Hola! Soy Jorge Aparicio</h2>\r\n            <p class=\"text-sm sm:text-base lg:text-lg text-gray-300 leading-relaxed max-w-3xl mx-auto\">\r\n                Soy Jorge Luis Giovanni Aparicio Álvarez, estudiante de Ingeniería de Software en la Universidad San Ignacio de Loyola, actualmente en el noveno ciclo. Me interesa el desarrollo de soluciones web completas, desde la interfaz hasta la lógica del sistema, y me entusiasma aprender constantemente.\r\n            </p>\r\n        </div>\r\n    </section>\r\n    \r\n    \r\n    <section class=\"bg-gray-900/60 backdrop-blur-sm py-8 sm:py-12 lg:py-16 border-y border-gray-800\">\r\n   <div class=\"max-w-6xl mx-auto px-4 sm:px-6 text-center\">\r\n    <h3 class=\"text-xl sm:text-2xl lg:text-3xl font-bold text-red-500 mb-6 sm:mb-8 lg:mb-10 drop-shadow-sm\">Intereses personales</h3>\r\n    \r\n    <!-- Primera fila de 4 cards -->\r\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8 text-gray-300 text-sm sm:text-base lg:text-lg justify-center\">\r\n      <div class=\"bg-gray-900/90 shadow-lg rounded-xl p-4 sm:p-6 transition-all duration-300 border border-gray-800 hover:border-red-500/30\">\r\n        <div class=\"text-center\">Bases de datos</div>\r\n      </div>\r\n      <div class=\"bg-gray-900/90 shadow-lg rounded-xl p-4 sm:p-6 transition-all duration-300 border border-gray-800 hover:border-red-500/30\">\r\n        <div class=\"text-center\">Desarrollo Frontend</div>\r\n      </div>\r\n      <div class=\"bg-gray-900/90 shadow-lg rounded-xl p-4 sm:p-6 transition-all duration-300 border border-gray-800 hover:border-red-500/30\">\r\n        <div class=\"text-center\">Desarrollo Backend</div>\r\n      </div>\r\n      <div class=\"bg-gray-900/90 shadow-lg rounded-xl p-4 sm:p-6 transition-all duration-300 border border-gray-800 hover:border-red-500/30\">\r\n        <div class=\"text-center\">Tecnología e innovación</div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Segunda fila: centrado con flex -->\r\n    <div class=\"flex justify-center mt-4 sm:mt-6 lg:mt-8 text-gray-300 text-sm sm:text-base lg:text-lg\">\r\n      <div class=\"bg-gray-900/90 shadow-lg rounded-xl p-4 sm:p-6 transition-all duration-300 border border-gray-800 hover:border-red-500/30\">\r\n        <div class=\"text-center\">Routing y Switching</div>\r\n      </div>\r\n    </div>\r\n   </div>\r\n</section>\r\n\r\n    \r\n    \r\n    <section class=\"bg-gray-900/40 backdrop-blur-sm py-8 sm:py-12 lg:py-16\">\r\n        <div class=\"max-w-6xl mx-auto px-4 sm:px-6 text-center\">\r\n            <h3 class=\"text-xl sm:text-2xl lg:text-3xl font-bold text-red-500 mb-6 sm:mb-8 lg:mb-10 drop-shadow-sm\">Habilidades blandas</h3>\r\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 text-gray-300 text-sm sm:text-base lg:text-lg\">\r\n                <div class=\"bg-gray-900/90 shadow-lg rounded-xl p-4 sm:p-6 transition-all duration-300 flex items-center justify-center text-center min-h-[80px] sm:min-h-[100px] lg:min-h-[120px] border border-gray-800 hover:border-red-500/30\">\r\n                    Trabajo en equipo\r\n                </div>\r\n                <div class=\"bg-gray-900/90 shadow-lg rounded-xl p-4 sm:p-6 transition-all duration-300 flex items-center justify-center text-center min-h-[80px] sm:min-h-[100px] lg:min-h-[120px] border border-gray-800 hover:border-red-500/30\">\r\n                    Actitud positiva\r\n                </div>\r\n                <div class=\"bg-gray-900/90 shadow-lg rounded-xl p-4 sm:p-6 transition-all duration-300 flex items-center justify-center text-center min-h-[80px] sm:min-h-[100px] lg:min-h-[120px] border border-gray-800 hover:border-red-500/30\">\r\n                    Capacidad de aprendizaje rápido y adaptación\r\n                </div>\r\n                <div class=\"bg-gray-900/90 shadow-lg rounded-xl p-4 sm:p-6 transition-all duration-300 flex items-center justify-center text-center min-h-[80px] sm:min-h-[100px] lg:min-h-[120px] border border-gray-800 hover:border-red-500/30\">\r\n                    Proactividad\r\n                </div>\r\n                <div class=\"bg-gray-900/90 shadow-lg rounded-xl p-4 sm:p-6 transition-all duration-300 flex items-center justify-center text-center min-h-[80px] sm:min-h-[100px] lg:min-h-[120px] border border-gray-800 hover:border-red-500/30\">\r\n                    Empatía\r\n                </div>\r\n                <div class=\"bg-gray-900/90 shadow-lg rounded-xl p-4 sm:p-6 transition-all duration-300 flex items-center justify-center text-center min-h-[80px] sm:min-h-[100px] lg:min-h-[120px] border border-gray-800 hover:border-red-500/30\">\r\n                    Orientación al servicio y atención al cliente\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n\r\n    \r\n        <!-- Sección: C